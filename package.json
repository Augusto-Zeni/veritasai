{
  "name": "veritasai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @veritasai/api --filter @veritasai/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "pnpm --filter @veritasai/core verify",
    "eval:run": "pnpm --filter @veritasai/eval run:eval",
    "eval:metrics": "pnpm --filter @veritasai/eval metrics",
    "eval:calibrate": "pnpm --filter @veritasai/eval calibrate",
    "eval:sample-claims": "pnpm --filter @veritasai/eval sample-claims",
    "eval:kappa": "pnpm --filter @veritasai/eval kappa"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
