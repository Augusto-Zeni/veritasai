{
  "name": "veritasai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @veritasai/api --filter @veritasai/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "tsx --env-file-if-exists=.env packages/core/src/cli.ts",
    "eval:run": "tsx --env-file-if-exists=.env eval/scripts/run.ts",
    "eval:metrics": "tsx eval/scripts/metrics.ts",
    "eval:calibrate": "tsx eval/scripts/calibrate.ts",
    "eval:sample-claims": "tsx eval/scripts/sample-claims.ts",
    "eval:kappa": "tsx eval/scripts/kappa.ts",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
