GEMINI_API_KEY=
GEMINI_MODEL=            # ex.: o Flash vigente; confirmar em ai.google.dev
SERPER_API_KEY=
JINA_API_KEY=
LLM_RPM=5
LLM_RPD=100
MAX_ARTICLE_CHARS=20000
MAX_CLAIMS=10
SEARCH_TOP_K=5
EVIDENCE_PAGES=3
EXCLUDE_FACTCHECK_DOMAINS=false
CACHE_PATH=./data/cache.sqlite

# API (apps/api)
PORT=3000
API_MAX_CONCURRENT_JOBS=1   # verificações simultâneas; 1 mantém o consumo por notícia exato
API_MAX_QUEUE=20            # acima disso, POST /verify responde 503
API_JOB_TTL_MS=900000       # tempo que um resultado fica disponível em memória (15 min)
